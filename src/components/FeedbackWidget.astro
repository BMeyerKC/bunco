---
// src/components/FeedbackWidget.astro
// Feedback trigger button + <dialog>. Rendered inside the site footer by
// Layout.astro, on every page that does not opt out via showFeedback={false}.
const version = import.meta.env.PUBLIC_VERSION || 'dev';
---
<button id="feedback-fab" class="feedback-btn" type="button" aria-haspopup="dialog" data-dialog-open="feedback-modal">
  <span aria-hidden="true">✍</span> Send feedback
</button>

<dialog id="feedback-modal" class="sheet-dialog" aria-labelledby="feedback-modal-title">
  <form id="feedback-form" data-version={version}>
    <div class="dialog-head">
      <h2 id="feedback-modal-title">Send us feedback</h2>
      <button type="button" class="dialog-close" data-dialog-close aria-label="Close">×</button>
    </div>
    <div class="dialog-body stack">
      <div>
        <label for="feedback-message" class="field-label">What's on your mind?</label>
        <textarea id="feedback-message" class="field" rows="5" maxlength="1000"
                  placeholder="Something confusing, something broken, or an idea"></textarea>
      </div>
      <div>
        <label for="feedback-contact" class="field-label">
          Name or email <span class="helper" style="font-weight:400;">(only if you'd like a reply)</span>
        </label>
        <input id="feedback-contact" type="text" class="field" maxlength="200" autocomplete="off" />
      </div>
    </div>
    <div class="dialog-actions">
      <button type="button" class="btn-quiet" data-dialog-close>Cancel</button>
      <button type="submit" id="feedback-send" class="btn-pen" disabled>Send feedback</button>
    </div>
  </form>
</dialog>
