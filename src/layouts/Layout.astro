---
// src/layouts/Layout.astro
import '../styles/base.css';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import DieIcon from '../components/DieIcon.astro';

type Props = {
  title: string;
  showFeedback?: boolean;
  showFooter?: boolean;
  /** Home page: the wordmark is the page's own brand, not a way back. */
  isHome?: boolean;
};
const { title, showFeedback = true, showFooter = true, isHome = false } = Astro.props;
const version = import.meta.env.PUBLIC_VERSION || 'dev';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <script is:inline>
    // Pre-paint theme application — mirrors resolveTheme() in src/js/theme.js.
    (function () {
      var stored = null;
      try { stored = localStorage.getItem('bunco_theme'); } catch (e) {}
      var theme = (stored === 'light' || stored === 'dark')
        ? stored
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <header class="topbar">
    {isHome ? (
      <span class="wordmark"><DieIcon face={5} /> Bunco</span>
    ) : (
      <a class="wordmark" href="index.html" aria-label="Bunco home">
        <DieIcon face={5} /> <span class="wordmark-back" aria-hidden="true">←</span> Home
      </a>
    )}
    <slot name="topbar" />
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch between light and dark theme">
      <span class="theme-icon-to-dark" aria-hidden="true">☾</span>
      <span class="theme-icon-to-light" aria-hidden="true">☀</span>
    </button>
  </header>

  <main class="site-main">
    <slot />
  </main>

  {showFooter && (
    <footer class="site-footer">
      <span class="version-tag">Version {version}</span>
      {showFeedback && <FeedbackWidget />}
    </footer>
  )}

  <script>
    import { initTheme } from '../js/theme.js';
    import { initFeedback } from '../js/feedback-controller.js';
    import { initDialogs } from '../js/dialogs.js';
    initTheme();
    initDialogs();
    initFeedback();
  </script>
</body>
</html>
