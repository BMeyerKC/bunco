---
import Layout from '../layouts/Layout.astro';
import '../styles/tools.css';
---
<Layout title="Bunco Debug" showFeedback={false}>
  <div class="tool-page">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <h1 style="margin:0;">Event log</h1>
      <span id="debug-code" style="font-weight:900;font-size:var(--fs-lead);color:var(--pen);letter-spacing:0.12em;"></span>
    </div>
    <div id="event-timeline" style="overflow-y:auto;max-height:calc(100vh - 100px);">
      <p style="color:var(--very-muted);">Loading…</p>
    </div>
  </div>
  <script>
    import '../js/debug-controller.js';
  </script>
</Layout>
