---
import GameLayout from '../layouts/GameLayout.astro';
---
<GameLayout title="Bunco Game">

  <!-- VIEW: Host setup — one question: how many people are here? -->
  <div id="view-setup" data-view class="page page-centered">
    <h1>Host a game night</h1>
    <p class="lead">How many people are playing tonight?</p>

    <div class="stepper" role="group" aria-label="Number of players">
      <button type="button" id="players-dec" aria-label="One fewer player">−</button>
      <input id="setup-players" type="number" inputmode="numeric" min="1" max="24" value="12"
             aria-label="Number of players" />
      <button type="button" id="players-inc" aria-label="One more player">+</button>
    </div>

    <div class="setup-plan" aria-live="polite">
      <div id="setup-tables-diagram" class="table-diagram" aria-hidden="true"></div>
      <p id="setup-plan-text" class="setup-plan-text"></p>
      <p id="setup-ghost-note" class="helper" hidden>
        A ghost fills each empty seat so every table has four. Ghosts move with their team
        like anyone else.
      </p>
    </div>

    <!-- Read by game-controller.js; kept in sync with the stepper below -->
    <input type="hidden" id="setup-tables" value="3" />
    <input type="hidden" id="setup-ghosts" value="0" />

    <button id="create-game-btn" class="btn-pen btn-block">Create game</button>
  </div>

  <!-- VIEW: Waiting room -->
  <div id="view-waiting" data-view style="display:none;" class="page">
    <!-- Seat card first: once seated, it's the thing a player needs -->
    <!-- Shown to players once seats are assigned -->
    <div id="waiting-seat-info" style="display:none;" class="index-card seat-card">
      <p class="seat-card-label">Your seat</p>
      <h2 id="waiting-seat-table" class="seat-card-table"></h2>
      <dl class="seat-card-people">
        <dt>Partner</dt><dd id="waiting-seat-teammate"></dd>
        <dt>Against</dt><dd id="waiting-seat-opponents"></dd>
      </dl>
      <p class="helper" style="margin:0;">The host will start round 1 shortly.</p>
    </div>

    <section class="code-card">
      <p class="code-card-label">Game code</p>
      <h1 class="waiting-code-display" id="waiting-code">----</h1>
      <div id="waiting-qr" class="qr"></div>
      <p class="helper">Scan the code, or go to bunco.io and type it in.</p>
    </section>

    <p class="waiting-count">
      <strong id="waiting-count">0</strong> of <span id="waiting-total">0</span> players are here
    </p>
    <div id="waiting-player-list" class="chips"></div>

    <div id="host-seat-layout" style="display:none;" class="seat-layout"></div>

    <div id="host-join-player" style="display:none;" class="host-join">
      <label for="host-join-name" class="field-label">Playing too? Add yourself</label>
      <div class="inline-form">
        <input id="host-join-name" type="text" class="field" placeholder="Your name"
               maxlength="20" autocomplete="given-name" />
        <button id="host-join-btn" class="btn-ink">Join as a player</button>
      </div>
    </div>

    <div id="host-controls" style="display:none;" class="host-controls">
      <button id="random-seat-btn" class="btn-ink btn-block">Assign seats at random</button>
      <button id="start-round-btn" class="btn-pen btn-block" disabled>Start round 1</button>
    </div>
  </div>

  <!-- VIEW: Join (player enters name) -->
  <div id="view-join" data-view style="display:none;" class="page page-centered">
    <h1>Join game <span id="join-display-code" class="inline-code"></span></h1>

    <!-- Pre-game: name entry form -->
    <div id="join-pregame">
      <div id="join-live-count-pill" class="live-count-pill" style="display:none;">
        <div class="live-dot" aria-hidden="true"></div>
        <span id="join-live-count"></span>
      </div>
      <label for="join-name" class="field-label">Your name</label>
      <input id="join-name" type="text" class="field field-lg" placeholder="First name is fine"
             maxlength="20" autocomplete="given-name" />
      <button id="join-btn" class="btn-pen btn-block" style="margin-top:16px;">Join game</button>
      <p class="join-alt">
        <a id="join-spectate-link" href="#">Just watch the scores instead</a>
      </p>
    </div>

    <!-- In-progress: spectate or take a ghost seat -->
    <div id="join-inprogress" style="display:none;">
      <p class="lead">This game has already started.</p>
      <a id="join-spectate-btn" href="#" class="btn-ink btn-block">Watch the scores</a>
      <div id="join-ghost-section" style="display:none;" class="ghost-seats">
        <p class="field-label">Or take over an empty seat</p>
        <div id="join-ghost-list" class="stack-sm"></div>
        <div id="join-ghost-claim" style="display:none;">
          <label for="join-ghost-name" class="field-label">Your name</label>
          <input id="join-ghost-name" type="text" class="field field-lg" placeholder="First name is fine"
                 maxlength="20" autocomplete="given-name" />
          <button id="join-ghost-confirm" class="btn-pen btn-block" style="margin-top:16px;">Take this seat</button>
          <button id="join-ghost-cancel" class="btn-quiet btn-block">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW: Scoring -->
  <div id="view-scoring" data-view style="display:none;" class="scoreboard">

    <div class="score-topbar">
      <span id="round-label" class="round-label"></span>
      <span id="game-called-banner" class="game-called-pill" role="status">GAME CALLED — finish your roll</span>
    </div>

    <!-- BUNCO! celebration overlay -->
    <div id="bunco-overlay" aria-hidden="true">
      <canvas id="bunco-canvas"></canvas>
      <div id="bunco-flash"></div>
      <div id="bunco-content">
        <div id="bunco-text">BUNCO!</div>
        <div id="bunco-dice">
          <div class="bunco-die" id="bunco-d1">⚄</div>
          <div class="bunco-die" id="bunco-d2">⚄</div>
          <div class="bunco-die" id="bunco-d3">⚄</div>
        </div>
        <div id="bunco-pts">Your team wins this table!</div>
      </div>
    </div>

    <div class="score-halves">
      <div id="sc-us" class="score-half">
        <button type="button" class="side-add" aria-label="Add a point for your team"></button>
        <div class="half-team-label">Us</div>
        <div id="sc-us-names" class="half-player-names"></div>
        <div id="sc-us-score" class="half-score-num" aria-live="polite">0</div>
        <div id="sc-us-tally" class="tally"></div>
        <p class="tap-hint">Tap here to add a point</p>
        <button id="sc-us-dec" class="half-dec-btn" aria-label="Take a point from your team">−1</button>
      </div>

      <div class="score-half-divider" aria-hidden="true"></div>

      <div id="sc-them" class="score-half">
        <button type="button" class="side-add" aria-label="Add a point for the other team"></button>
        <div class="half-team-label">Them</div>
        <div id="sc-them-names" class="half-player-names"></div>
        <div id="sc-them-score" class="half-score-num" aria-live="polite">0</div>
        <div id="sc-them-tally" class="tally"></div>
        <p class="tap-hint">Tap here to add a point</p>
        <button id="sc-them-dec" class="half-dec-btn" aria-label="Take a point from the other team">−1</button>
      </div>
    </div>

    <div class="score-footer game-footer">
      <button id="call-game-btn">Call game</button>
      <button id="bunco-btn">🎲 BUNCO!</button>
      <button id="submit-scores-btn">Submit</button>
    </div>

    <!-- BUNCO player picker — who rolled it? -->
    <div id="bunco-picker" class="bunco-picker-overlay" style="display:none;">
      <div class="bunco-picker-card" role="dialog" aria-modal="true" aria-labelledby="bunco-picker-title">
        <h2 id="bunco-picker-title" class="bunco-picker-title">Who rolled the Bunco?</h2>
        <div id="bunco-picker-list" class="bunco-picker-list"></div>
        <p id="bunco-picker-ghost-note" class="helper" hidden>
          Ghosts can't earn a Bunco. If a ghost rolls one, add it to their points instead.
        </p>
        <button id="bunco-picker-cancel" class="btn-quiet btn-block">Cancel</button>
      </div>
    </div>

  </div>

  <!-- VIEW: Round submitted / waiting for others -->
  <div id="view-submitted" data-view style="display:none;" class="page page-centered center-text">
    <div class="submitted-check" aria-hidden="true">✓</div>
    <h1>Scores sent</h1>
    <p class="lead">Waiting for the other tables to finish.</p>
    <div id="submitted-table-dots" class="table-progress-row"></div>
    <a id="view-standings-link" href="standings.html" class="btn-ink btn-block">See standings</a>
  </div>

  <!-- VIEW: Between rounds — auto-shown when all tables submit -->
  <div id="view-between-rounds" data-view style="display:none;" class="page">
    <h1 id="br-round-title"></h1>
    <p class="lead">Every table is in.</p>

    <!-- Next seat (hidden on round 6) — first, because it's what players need to act on -->
    <div id="br-next-seat" class="index-card seat-card" style="display:none;">
      <p class="seat-card-label">Your next seat</p>
      <h2 id="br-next-table" class="seat-card-table"></h2>
      <dl class="seat-card-people">
        <dt>Partner</dt><dd id="br-next-teammate"></dd>
        <dt>Against</dt><dd id="br-next-opponents"></dd>
      </dl>
    </div>

    <section class="sheet-box br-standings">
      <h2 class="br-standings-title">Standings so far</h2>
      <div id="br-standings-list"></div>
    </section>

    <!-- Host: start next round. Others: waiting message. -->
    <button id="br-start-next-btn" class="btn-pen btn-block" style="display:none;"></button>
    <p id="br-waiting-msg" class="helper center-text" style="display:none;">The host will start the next round.</p>
    <a id="br-standings-link" href="standings.html" class="btn-quiet btn-block">See full standings</a>
  </div>

  <!-- QRCode CDN — keep as is:inline so Vite ignores it -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

  <script>
    import '../js/game-controller.js';
    import { initSetupStepper } from '../js/setup-stepper.js';
    initSetupStepper();
  </script>

  <!-- BUNCO animation — uses globals, must stay inline -->
  <script is:inline>
    window.playBuncoAnimation = function () {
      const overlay = document.getElementById('bunco-overlay');
      const flash   = document.getElementById('bunco-flash');
      const text    = document.getElementById('bunco-text');
      const dice    = document.getElementById('bunco-dice');
      const pts     = document.getElementById('bunco-pts');
      const canvas  = document.getElementById('bunco-canvas');

      // Reset
      overlay.classList.add('playing');
      flash.className  = 'bunco-flash';
      text.className   = '';
      dice.className   = '';
      pts.className    = '';
      ['bunco-d1','bunco-d2','bunco-d3'].forEach(id => {
        document.getElementById(id).className = 'bunco-die';
      });
      canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);

      requestAnimationFrame(() => {
        flash.classList.add('go');
        text.classList.add('pop');

        setTimeout(() => {
          dice.classList.add('slide-in');
          ['bunco-d1','bunco-d2','bunco-d3'].forEach((id, i) => {
            setTimeout(() => document.getElementById(id).classList.add('shake'), i * 80);
          });
        }, 400);

        setTimeout(() => pts.classList.add('fade-in'), 900);

        setTimeout(() => overlay.classList.remove('playing'), 2200);
      });

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) launchConfetti(canvas);
    };

    function launchConfetti(canvas) {
      canvas.width  = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      const ctx = canvas.getContext('2d');
      const styles = getComputedStyle(document.documentElement);
      const themeColors = ['--margin', '--marker', '--pen', '--rule']
        .map(n => styles.getPropertyValue(n).trim())
        .filter(Boolean);
      const colors = themeColors.length ? themeColors : ['#d9474c', '#ffe66b'];
      const pieces = Array.from({ length: 70 }, () => ({
        x:  canvas.width  / 2 + (Math.random() - 0.5) * 60,
        y:  canvas.height / 2,
        r:  Math.random() * 5 + 3,
        c:  colors[Math.floor(Math.random() * colors.length)],
        vx: (Math.random() - 0.5) * 9,
        vy: Math.random() * -7 - 2,
        gy: 0.18,
        rot: Math.random() * 360,
        rv: (Math.random() - 0.5) * 10,
        alpha: 1,
      }));
      let frame = 0;
      (function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach(p => {
          p.vy += p.gy; p.x += p.vx; p.y += p.vy; p.rot += p.rv;
          p.alpha = Math.max(0, 1 - frame / 90);
          ctx.save();
          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = p.c;
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot * Math.PI / 180);
          ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
          ctx.restore();
        });
        frame++;
        if (frame < 110) requestAnimationFrame(draw);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
      })();
    }
  </script>

</GameLayout>
