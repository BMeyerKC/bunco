---
import Layout from '../layouts/Layout.astro';
import '../styles/game.css';
---
<Layout title="Standings — Bunco">
  <div class="page">

    <!-- Shown only when no ?code= param in URL -->
    <div id="no-code-section" style="display:none;">
      <h1>Watch a game</h1>
      <p class="lead">Type the game code to follow the scores live.</p>
      <form id="code-form" class="join-form" novalidate>
        <label for="code-input" class="visually-hidden">Game code</label>
        <div class="code-slots">
          <input id="code-input" type="text" maxlength="4"
                 autocomplete="off" autocorrect="off" autocapitalize="characters" spellcheck="false"
                 aria-describedby="code-error" />
          <span class="code-slot" aria-hidden="true"></span>
          <span class="code-slot" aria-hidden="true"></span>
          <span class="code-slot" aria-hidden="true"></span>
          <span class="code-slot" aria-hidden="true"></span>
        </div>
        <p id="code-error" class="field-error" hidden></p>
        <button type="submit" class="btn-pen btn-block" style="margin-top:18px;">Watch game</button>
      </form>
    </div>

    <!-- Shown when ?code= param is present -->
    <div id="standings-section">
      <h1 id="standings-title">Standings</h1>
      <p id="round-indicator" class="lead"></p>

      <!-- Live table cards — shown once seats are assigned -->
      <div id="table-cards" class="seat-layout"></div>

      <!-- Ghost table scoring (host only) -->
      <section id="ghost-scoring-section" style="display:none;" class="ghost-section">
        <h2 class="section-title">Ghost tables</h2>
        <p class="helper">No one is sitting at these. Enter their scores to finish the round.</p>
        <div id="ghost-tables-list" class="stack-sm"></div>
      </section>

      <!-- Start next round (host only) -->
      <div id="advance-round-section" style="display:none;" class="index-card advance-card">
        <p>Every table has turned in its scores.</p>
        <button id="advance-round-btn" class="btn-pen btn-block">Start round <span id="next-round-num">2</span></button>
      </div>

      <section aria-labelledby="leaderboard-title">
        <h2 id="leaderboard-title" class="section-title">Leaderboard</h2>
        <div class="standings-table" role="table" aria-label="Player standings">
          <div class="standings-row standings-header" role="row">
            <span role="columnheader"><span class="visually-hidden">Rank</span></span>
            <span role="columnheader">Player</span>
            <span role="columnheader" class="standings-stat"><abbr title="Wins">W</abbr></span>
            <span role="columnheader" class="standings-stat"><abbr title="Losses">L</abbr></span>
            <span role="columnheader" class="standings-stat"><abbr title="Buncos">🎲</abbr></span>
            <span role="columnheader" class="standings-stat"><abbr title="Total points">Pts</abbr></span>
          </div>
          <div id="standings-body" role="rowgroup">
            <p class="helper" style="padding:12px 0;">Loading the scores…</p>
          </div>
        </div>
        <p class="helper standings-key">Ranked by wins, then Buncos, then total points.</p>
      </section>

      <button id="leave-game-btn" class="btn-quiet" style="display:none; margin-top:20px;">Leave this game</button>

      <!-- AdSense — shown only on final standings; place the ad unit here after approval -->
      <div id="ad-slot" style="display:none;"></div>
    </div>

  </div>

  <script>
    import '../js/standings-controller.js';
  </script>
</Layout>
