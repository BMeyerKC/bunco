---
import Layout from '../layouts/Layout.astro';
import '../styles/game.css';
---
<Layout title="Quick Scorer — Bunco">
  <div id="app" class="scoreboard quick-board">
    <div class="score-halves">
      <div class="score-half" id="us-half">
        <button type="button" class="side-add" aria-label="Add a point for Us"></button>
        <div class="half-team-label">Us</div>
        <div class="half-score-num" id="us-score" aria-live="polite">0</div>
        <div class="tally" id="us-tally"></div>
        <p class="tap-hint">Tap here to add a point</p>
        <button type="button" class="half-dec-btn" id="us-dec" aria-label="Take a point from Us">−1</button>
      </div>

      <div class="score-half-divider" aria-hidden="true"></div>

      <div class="score-half" id="them-half">
        <button type="button" class="side-add" aria-label="Add a point for Them"></button>
        <div class="half-team-label">Them</div>
        <div class="half-score-num" id="them-score" aria-live="polite">0</div>
        <div class="tally" id="them-tally"></div>
        <p class="tap-hint">Tap here to add a point</p>
        <button type="button" class="half-dec-btn" id="them-dec" aria-label="Take a point from Them">−1</button>
      </div>
    </div>

    <div class="score-footer">
      <span class="score-goal">First to 21 wins the set</span>
      <button type="button" id="new-set-btn" class="btn-ink btn-sm" disabled>New set</button>
    </div>
  </div>

  <script>
    import '../js/quick-scorer.js';
    import '../js/quick-scorer-tracking.js';
  </script>
</Layout>
