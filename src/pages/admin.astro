---
import Layout from '../layouts/Layout.astro';
import '../styles/tools.css';
const version = import.meta.env.PUBLIC_VERSION || 'dev';
---
<Layout title="Bunco Admin" showFeedback={false}>
  <meta slot="head" name="robots" content="noindex" />
  <div class="tool-page">
    <h1>Admin</h1>

    <section id="admin-links" class="tool-section">
      <h2>Quick Links</h2>
      <div class="tool-row">
        <a href="/tests.html" class="btn-ink btn-sm">Unit Tests</a>
        <a href="/playwright-report/index.html" class="btn-ink btn-sm" target="_blank">E2E Report</a>
        <form id="debug-jump" class="tool-row">
          <input id="debug-code-input" class="field field-sm"
                 style="width:100px;text-transform:uppercase;letter-spacing:0.1em;" maxlength="4"
                 placeholder="CODE" autocomplete="off" />
          <button class="btn-ink btn-sm" type="submit">Open debug log</button>
        </form>
      </div>
      <p id="debug-code-error" class="tool-error"></p>
    </section>

    <section id="admin-stats" class="tool-section">
      <h2>Stats</h2>
      <div class="tool-row">
        <div class="stat-tile">
          <div id="stat-active" class="stat-tile-value">–</div>
          <div class="stat-tile-label">Active now (24h)</div>
        </div>
        <div class="stat-tile">
          <div id="stat-recent" class="stat-tile-value">–</div>
          <div class="stat-tile-label">Recent games shown</div>
        </div>
        <div class="stat-tile">
          <div class="stat-tile-value">{version}</div>
          <div class="stat-tile-label">App version</div>
        </div>
      </div>
    </section>

    <section id="admin-feedback" class="tool-section">
      <h2>Feedback</h2>
      <div id="feedback-list">
        <p style="color:var(--very-muted);">Loading…</p>
      </div>
    </section>

    <section id="admin-games" class="tool-section">
      <h2>Recent Games</h2>
      <div id="games-list" class="table-scroll">
        <p style="color:var(--very-muted);">Loading…</p>
      </div>
    </section>

    <section id="admin-quick-scorer">
      <h2>Quick Scorer Sessions</h2>
      <div id="quick-scorer-list" class="table-scroll">
        <p style="color:var(--very-muted);">Loading…</p>
      </div>
    </section>
  </div>
  <script>
    import '../js/admin-controller.js';
  </script>
</Layout>
