---
import Layout from '../layouts/Layout.astro';
import DieIcon from '../components/DieIcon.astro';
import '../styles/home.css';
---
<Layout title="Bunco Score Keeper — Free Online Bunco Game" isHome>
  <Fragment slot="head">
    <meta name="description" content="Free Bunco score keeper and live scoring app. Learn how to play Bunco with quick-start rules and a full reference guide." />
    <meta name="keywords" content="bunco score keeper, how to play bunco, bunco rules, bunco scoring app" />
    <link rel="canonical" href="https://bunco.io/" />

    <meta property="og:title" content="Bunco — Live Score Keeper &amp; Rules" />
    <meta property="og:description" content="Free Bunco score keeper app. Track your game night live, plus quick-start rules and full Bunco reference." />
    <meta property="og:url" content="https://bunco.io/" />
    <meta property="og:type" content="website" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to Play Bunco",
      "description": "Bunco is a fast-paced dice game for groups of 6 or more players. Here's how to play.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Set up your tables",
          "text": "Seat 4 players per table (2 vs 2). You need 3 dice per table. Designate one table as the head table (Table 1)."
        },
        {
          "@type": "HowToStep",
          "name": "Know your target number",
          "text": "Each of the 6 rounds has a target number matching the round — round 1 targets 1s, round 2 targets 2s, and so on."
        },
        {
          "@type": "HowToStep",
          "name": "Roll and score",
          "text": "Teams roll all 3 dice and score 1 point per die matching the round number. Rolling all 3 matching dice is a Bunco — 21 points, round over at your table."
        },
        {
          "@type": "HowToStep",
          "name": "Call game",
          "text": "The first table to reach 21 calls Game. Other tables finish their current roll then stop."
        },
        {
          "@type": "HowToStep",
          "name": "Rotate and repeat",
          "text": "Losing teams stay. Winning teams (except at Table 1) advance toward Table 1. Losers at Table 1 drop to the last table. Play 6 rounds."
        }
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a Bunco?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Bunco is when you roll all 3 dice and they all match the current round number. It scores 21 points instantly and ends the round at your table."
          }
        },
        {
          "@type": "Question",
          "name": "How many players do you need to play Bunco?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bunco requires a minimum of 8 players (2 tables of 4). The most common setup is 12 players across 3 tables. Ghost players can fill empty seats if your group isn't a multiple of 4."
          }
        },
        {
          "@type": "Question",
          "name": "What happens on a tie in Bunco?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If both teams reach 21 at the same time, the team that was winning most recently takes the win, or flip a coin."
          }
        },
        {
          "@type": "Question",
          "name": "What is a ghost player in Bunco?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A ghost player is a placeholder used when you don't have enough people for full tables of 4. The ghost rotates like a normal player. The team playing against the ghost scores against the ghost's previous round score."
          }
        }
      ]
    }
    </script>
  </Fragment>

  <div class="page home">

    <!-- Resume note — shown by resume-banner.js when this device was recently in a game -->
    <div id="resume-banner" class="resume-note" style="display:none;" role="status">
      <span id="resume-banner-text" class="resume-note-text"></span>
      <a id="resume-banner-link" href="#" class="btn-pen btn-sm"></a>
      <button id="resume-banner-dismiss" type="button" class="dialog-close" aria-label="Dismiss">×</button>
    </div>

    <!-- The join box is the front door: most people arriving tonight are joining. -->
    <section class="pad" aria-labelledby="join-title">
      <h1 id="join-title" class="pad-title">Join tonight's game</h1>
      <p class="pad-lead">Type the code from the host's screen.</p>
      <form id="join-form" class="join-form" novalidate>
        <label for="join-code" class="visually-hidden">Game code</label>
        <div class="code-slots">
          <input id="join-code" name="code" type="text" maxlength="4"
                 autocomplete="off" autocorrect="off" autocapitalize="characters" spellcheck="false"
                 aria-describedby="join-error" />
          <span class="code-slot" aria-hidden="true"></span>
          <span class="code-slot" aria-hidden="true"></span>
          <span class="code-slot" aria-hidden="true"></span>
          <span class="code-slot" aria-hidden="true"></span>
        </div>
        <p id="join-error" class="field-error" hidden></p>
        <button type="submit" class="btn-pen btn-block">Join game</button>
      </form>
    </section>

    <nav class="paths" aria-label="Other ways to play">
      <a class="path" href="game.html?host=true">
        <DieIcon face={6} class="path-die" />
        <span class="path-text">
          <strong>Host a game night</strong>
          <span>Set up tables, seat everyone, and score all six rounds live.</span>
        </span>
        <span class="path-go" aria-hidden="true">›</span>
      </a>
      <a class="path" href="scorer.html">
        <DieIcon face={2} class="path-die" />
        <span class="path-text">
          <strong>Just keep score</strong>
          <span>A two-sided scoreboard for one table. No setup.</span>
        </span>
        <span class="path-go" aria-hidden="true">›</span>
      </a>
    </nav>

    <!-- A real sequence, so the steps are numbered — in the sheet's margin -->
    <section class="rules" aria-labelledby="how-title">
      <h2 id="how-title" class="ruled-heading">How to play Bunco</h2>
      <ol class="steps">
        <li><strong>Set up your tables.</strong> Seat 4 players per table (2 vs 2). You need 3 dice per table. Designate one table as the head table (Table 1).</li>
        <li><strong>Know your target number.</strong> Each of the 6 rounds has a target number matching the round (round 1 = 1s, round 2 = 2s, etc.).</li>
        <li><strong>Roll and score.</strong> Teams take turns rolling all 3 dice. Score 1 point for each die matching the round number. Rolling all 3 matching dice is a <strong>Bunco</strong>: your table scores 21 points and the round ends immediately at your table.</li>
        <li><strong>Call game.</strong> The first table to reach 21 points calls "Game!" All other tables finish their current roll, then stop and tally scores.</li>
        <li><strong>Rotate and repeat.</strong> Losing teams stay at their table. Winning teams (except at Table 1) advance up toward Table 1. The losing team at Table 1 drops all the way down to the last table. Play 6 rounds total.</li>
      </ol>
    </section>

    <section class="rules" aria-labelledby="ref-title">
      <h2 id="ref-title" class="ruled-heading">Rules reference</h2>
      <div class="ref-list">
        <details class="ref-item">
          <summary>Objective</summary>
          <div class="ref-body">
            Score the most wins across 6 rounds. Bonus points for Buncos. The player with the most wins at the end of the night takes the prize.
          </div>
        </details>
        <details class="ref-item">
          <summary>Setup and tables</summary>
          <div class="ref-body">
            <ul>
              <li>Minimum 2 tables (8 players), typically 3 tables (12 players)</li>
              <li>4 players per table, seated 2 vs 2</li>
              <li>Tables are numbered 1 through N. Table 1 is the head table</li>
              <li>Each table needs 3 dice</li>
              <li>Ghost players fill empty seats when player count doesn't divide evenly by 4</li>
            </ul>
          </div>
        </details>
        <details class="ref-item">
          <summary>Rolling and scoring</summary>
          <div class="ref-body">
            <ul>
              <li>Teams alternate rolling all 3 dice as fast as possible. There is no turn limit</li>
              <li>Score 1 point per die matching the current round number</li>
              <li>Keep a running tally. First team to 21 wins the round at that table</li>
              <li>A <strong>Bunco</strong> (all 3 dice matching the round number) scores 21 points instantly and ends the round at that table</li>
            </ul>
          </div>
        </details>
        <details class="ref-item">
          <summary>Calling game</summary>
          <div class="ref-body">
            <ul>
              <li>When any team reaches 21, they call "Game!" loudly</li>
              <li>All other tables finish their current roll, then stop</li>
              <li>Each table reports their score. Higher score wins that table's round</li>
              <li>In a tie, the team that was winning most recently wins (or flip a coin)</li>
            </ul>
          </div>
        </details>
        <details class="ref-item">
          <summary>Player rotation and partners</summary>
          <div class="ref-body">
            <ul>
              <li>After each round, <strong>losing teams stay at their table</strong></li>
              <li><strong>Winning teams (Tables 2 through N) move up one table</strong> toward Table 1</li>
              <li><strong>The losing team at Table 1 drops all the way to the last table</strong></li>
              <li>Winners and incoming players split up, so you never keep the same partner twice in a row</li>
              <li>This ensures everyone plays with different partners throughout the night</li>
            </ul>
          </div>
        </details>
        <details class="ref-item">
          <summary>Ghost players</summary>
          <div class="ref-body">
            <ul>
              <li>A ghost player fills a seat when there aren't enough real players for full tables</li>
              <li>Ghost players rotate normally and move with their team like a real player</li>
              <li>The team playing against a ghost scores against the ghost's score from the previous round</li>
            </ul>
          </div>
        </details>
        <details class="ref-item">
          <summary>Buncos</summary>
          <div class="ref-body">
            <ul>
              <li>A Bunco occurs when all 3 dice show the current round number on a single roll</li>
              <li>It scores 21 points instantly and ends the round at that table</li>
              <li>Buncos are tracked individually and count toward final tiebreaking</li>
              <li>Multiple Buncos can occur in the same round at different tables</li>
            </ul>
          </div>
        </details>
        <details class="ref-item">
          <summary>Winning the game</summary>
          <div class="ref-body">
            After 6 rounds, tally each player's wins, losses, and Buncos. Rankings:
            <ol>
              <li>Most wins</li>
              <li>Most Buncos (tiebreaker)</li>
              <li>Most total points (second tiebreaker)</li>
            </ol>
          </div>
        </details>
      </div>
    </section>

    <!-- AdSense: place the ad unit here after approval (no empty placeholder box). -->
  </div>

  <script>
    import { initCodeEntry } from '../js/code-entry.js';
    import '../js/resume-banner.js';

    initCodeEntry(document.getElementById('join-form'), (code) => {
      window.location.href = `game.html?code=${code}`;
    });
  </script>
</Layout>
