{
  "rules": {
    "games": {
      ".read": true,
      ".indexOn": ["meta/createdAt"],
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['meta'])"
      }
    },
    "originAudits": {
      ".read": true,
      "$code": {
        ".write": true
      }
    },
    "feedback": {
      ".read": true,
      ".indexOn": ["createdAt"],
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['message','createdAt'])",
        "message":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "page":      { ".validate": "newData.isString() && newData.val().length <= 300" },
        "code":      { ".validate": "newData.isString() && newData.val().length <= 8" },
        "version":   { ".validate": "newData.isString() && newData.val().length <= 40" },
        "theme":     { ".validate": "newData.isString() && newData.val().length <= 10" },
        "ua":        { ".validate": "newData.isString() && newData.val().length <= 300" },
        "deviceId":  { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other":    { ".validate": false }
      }
    },
    "feedbackContacts": {
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['contact'])",
        "contact":   { ".validate": "newData.isString() && newData.val().length <= 200" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other":    { ".validate": false }
      }
    }
  }
}
